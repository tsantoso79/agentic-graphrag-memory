# Required: PostgreSQL with the pgvector and pg_trgm extensions
AGENT_MEMORY_DB_URI=postgresql://USER:PASSWORD@localhost:5432/agent_memory
# Required: must match a row in the agents table (see README, Setup)
AGENT_ID=my-agent

# Knowledge graph extraction (Gemini primary, Claude Haiku fallback)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional paths (defaults shown)
# MEMORY_PYTHON=<current python>
# MEMORY_LOG_DIR=./logs
# MEMORY_KNOWLEDGE_DIR=~/knowledge
# KNOWLEDGE_DIR=~/knowledge            # used by tools/pdf_to_markdown.py
# MEMORY_MD_PATH=<project MEMORY.md>   # where the session handoff note is written
# TESSDATA_PREFIX=<tesseract tessdata> # only for --ocr

# Optional tracing dashboard
# CLAUDE_TRACE_ENABLED=1
# TRACE_SERVER_PORT=
